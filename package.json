{
    "name": "fetch-loading",
    "version": "0.2.0",
    "description": "Loading animation with three dots which can be displayed while data is being fetched from an API.",
    "type": "commonjs",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "rollup -c --bundleConfigAsCjs",
        "rollup": "npm run build",
        "test": "node --test",
        "test:types": "tsc -p test/tsconfig.json",
        "test:package": "publint --strict && attw --pack .",
        "prepublishOnly": "npm run build && npm test && npm run test:types && npm run test:package"
    },
    "files": [
        "dist/*"
    ],
    "keywords": [
        "loading",
        "animation",
        "fetch",
        "api",
        "spinner",
        "react",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/StackOverflowIsBetterThanAnyAI/fetch-loading.git"
    },
    "author": "Michael Münzenhofer",
    "license": "MIT",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/react": "^19.2.6",
        "prettier-es5": "^0.0.4",
        "publint": "^0.3.25",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rollup": "^4.62.2",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    },
    "prettier": "prettier-es5",
    "peerDependencies": {
        "react": ">=18 <20"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
